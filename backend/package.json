{
  "name": "heyu-pdf-backend",
  "version": "1.0.0",
  "description": "合羽PDF编辑器付费后端服务",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:diff": "prisma migrate diff",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "admin:bootstrap": "tsx scripts/admin-bootstrap.ts",
    "admin:reset-totp": "tsx scripts/admin-reset-totp.ts",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e:auth && npm run test:e2e:orders && npm run test:e2e:approvals && npm run test:e2e:ledger && npm run test:e2e:catalog && npm run test:e2e:flags && npm run test:e2e:alerts && npm run test:e2e:http",
    "test:e2e:auth": "tsx tests-e2e/auth.e2e.ts",
    "test:e2e:orders": "tsx tests-e2e/orders.e2e.ts",
    "test:e2e:http": "tsx tests-e2e/http.e2e.ts",
    "test:all": "npm run typecheck && npm run test && npm run test:e2e",
    "test:e2e:approvals": "tsx tests-e2e/approvals.e2e.ts",
    "test:e2e:ledger": "tsx tests-e2e/ledger.e2e.ts",
    "test:e2e:catalog": "tsx tests-e2e/catalog.e2e.ts",
    "test:e2e:flags": "tsx tests-e2e/flags.e2e.ts",
    "test:e2e:alerts": "tsx tests-e2e/alerts.e2e.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^3.3.7",
    "uuid": "^10.0.0",
    "zod": "^3.23.8",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.4",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.12.0",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "@types/nodemailer": "^6.4.17"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
