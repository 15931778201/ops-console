# ==================== 基础 ====================
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# 数据库（PostgreSQL，唯一事实来源）
DATABASE_URL="postgresql://user:password@localhost:5432/heyu_pdf?schema=public"

# Redis（限流/幂等加速；生产必须配置）
REDIS_URL="redis://localhost:6379"

# ==================== JWT ====================
# 至少 32 字符；生产禁止使用示例值（缺失/示例值将拒绝启动）
JWT_SECRET="your-super-secret-jwt-key-change-in-production-32chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ==================== CORS ====================
# 精确 origin 白名单（逗号分隔）；本地运营后台 1430 与桌面端需显式包含
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:1430,http://127.0.0.1:1430,http://[::1]:1430,tauri://localhost"

# ==================== 支付 ====================
# mock | wechat | alipay（生产禁止 mock；首发仅开放已验收渠道）
PAYMENT_PROVIDER=mock
# 回调基础地址（渠道通知 URL = ${PAYMENT_NOTIFY_BASE_URL}/api/payment/notify/{provider}）
PAYMENT_NOTIFY_BASE_URL="http://localhost:3001"

# 微信支付 V3（企业主体；沙箱验收后开生产）
WECHAT_APP_ID=""
WECHAT_MCH_ID=""
WECHAT_API_KEY=""
WECHAT_NOTIFY_URL=""
WECHAT_CERT_SERIAL_NO=""
WECHAT_PRIVATE_KEY_PATH=""
WECHAT_PLATFORM_CERT_PATH=""

# 支付宝（企业主体）
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
ALIPAY_NOTIFY_URL=""

# ==================== 验证码渠道 ====================
# console | sms | email（首发仅启用一种）
VERIFICATION_CHANNEL=console

# SMTP（VERIFICATION_CHANNEL=email）
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# 短信（VERIFICATION_CHANNEL=sms）
SMS_API_URL=""
SMS_API_KEY=""
SMS_SIGN_NAME=""
SMS_TEMPLATE_ID=""

# ==================== 邀请（首发不自动发放，仅归因/人工活动码） ====================
INVITER_REWARD_CREDITS=500
INVITEE_REWARD_CREDITS=200

# ==================== 免费档积分（种子数据） ====================
FREE_MONTHLY_CREDITS=100

# ==================== 运营后台 ====================
# 管理员 user id（逗号分隔）；break-glass 紧急通道，RBAC/MFA 新体系见下
ADMIN_USER_IDS=""

# 运营后台独立 JWT 密钥（与用户 token 隔离；生产必须显式配置，缺失将拒绝启动）
ADMIN_JWT_SECRET=""
ADMIN_ACCESS_EXPIRES_IN="15m"
ADMIN_REFRESH_EXPIRES_IN="30d"
# 两步登录中间令牌时效（密码→TOTP 间隙）
ADMIN_MFA_TOKEN_EXPIRES_IN="5m"
# TOTP 发行者（显示在 authenticator App）
ADMIN_TOTP_ISSUER="合羽PDF运营后台"
# 管理员密码最小长度（策略另要求含大小写与数字）
ADMIN_PASSWORD_MIN_LENGTH=12

# ==================== 计费扫描 ====================
# PENDING 预扣交易超过该分钟数自动回滚
BILLING_TXN_TIMEOUT_MINUTES=30

# ==================== 监控告警（T6.5） ====================
# 【生产必填】通知通道。未配置时告警**仍完整落库**且管理端可见，但不会推送到值班群。
# 不配置等于"没有电话"——请确保生产环境已填。
ALERT_WEBHOOK_URL=""
# 可选：作为 Authorization 请求头发送，不进日志也不进告警正文
ALERT_WEBHOOK_TOKEN=""

# 评估周期（毫秒），默认 5 分钟
ALERT_EVAL_INTERVAL_MS=300000
# 静默窗口（毫秒）：同规则在该窗口内不重复外发，避免持续故障刷爆值班群
ALERT_SILENCE_MS=1800000
# 连续命中几次才外发：单轮毛刺不该半夜叫人起来
ALERT_CONSECUTIVE_THRESHOLD=2
# 外发失败重试次数（指数退避 250ms → 500ms）
ALERT_MAX_RETRIES=2
# 阈值覆盖（可选）：key=value,key2=value2
# 例：ALERT_THRESHOLD_OVERRIDES="payment.createFailureRate=0.2,admin.loginFailureSpike=5"
# 注意：改阈值属配置变更，须走发布流程；后台页面**刻意不提供改阈值入口**
ALERT_THRESHOLD_OVERRIDES=""
